# Fixture: a user-hand-edited config exercising the
# tab-close-default + quit-with-sims-default + tab-close-multi-pane
# keys. Verifies they round-trip through ConfigFile alongside unknown
# keys and comments.

theme = nord
font-size = 14

# tab close prompt suppressed to shut down
tab-close-default = shutdown
# leave sims alone on quit
quit-with-sims-default = keep
# stop confirming multi-pane tab closes
tab-close-multi-pane = close
