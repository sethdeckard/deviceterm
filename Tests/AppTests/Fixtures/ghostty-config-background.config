# Fixture: a ghostty config that sets `background` to a hashed hex
# color. Exercises the happy path for `GhosttyThemeColors.background`
# — chrome surfaces tint themselves with this color so a green-tinted
# terminal palette visibly stains the title bar / tab strip above.

theme = catppuccin-mocha
font-size = 14

background = #0a1f0a
