# Fixture: a ghostty config that flips palette-hex interpretation
# from sRGB (the default) to Display P3 via `window-colorspace`.
# `GhosttyThemeColors.selectionBackground` must construct the
# resulting NSColor in the Display P3 colorspace so the focus
# border and drag overlay match the in-terminal text-selection
# color the user sees.

theme = catppuccin-mocha
window-colorspace = display-p3
selection-background = #1e5680
