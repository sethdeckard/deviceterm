# Release signing, notarization, and publishing config for `make release`
# and `make publish`.
#
# Copy this to `.env.release` (git-ignored) and fill in your values;
# build-release.sh and publish-release.sh source it automatically.
#
#   cp .env.release.example .env.release

# Developer ID Application identity. Find the exact string with:
#   security find-identity -v -p codesigning | grep "Developer ID Application"
export CODESIGN_IDENTITY="Developer ID Application: Your Name (TEAMID)"

# Notarization. Recommended: a notarytool keychain profile, which keeps
# the app-specific password in the macOS keychain instead of this file.
# Create it once (team id must match the signing cert's team):
#   xcrun notarytool store-credentials "deviceterm-notary" \
#     --apple-id "you@example.com" --team-id "TEAMID" \
#     --password "xxxx-xxxx-xxxx-xxxx"
export NOTARY_PROFILE="deviceterm-notary"

# Alternatively, use inline credentials instead of a profile (less
# secure: the app-specific password sits in this file). If you use
# these, remove the NOTARY_PROFILE line above.
# export APPLE_ID="you@example.com"
# export APPLE_TEAM_ID="TEAMID"
# export APPLE_APP_PASSWORD="xxxx-xxxx-xxxx-xxxx"

# Local checkout of the Homebrew tap; scripts/publish-release.sh renders
# Casks/deviceterm.rb into it and pushes after the GitHub release. Only
# needed when the checkout is not at the default ../homebrew-tap path.
# export DEVICETERM_TAP_DIR="$HOME/path/to/homebrew-tap"
